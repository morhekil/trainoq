{
  "name": "trainoq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "screenshots:baseline": "playwright test --update-snapshots",
    "screenshots:check": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply trainoq --local",
    "db:migrate:remote": "wrangler d1 migrations apply trainoq --remote",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "cf-typegen": "wrangler types backend/worker-configuration.d.ts",
    "setup:local": "node -e \"require('fs').existsSync('.dev.vars')||require('fs').copyFileSync('.dev.vars.example','.dev.vars')\" && npm run db:migrate:local"
  },
  "dependencies": {
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  }
}
